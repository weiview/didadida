<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 上傳跑在前景服務裡，Android 13+ 要自己要通知權限，不然那條通知不會出現 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 自己裝更新（APK 放在自己的網站上，不上 Google Play） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 桌面圖示每天 00:00 換臉的鬧鐘，重開機後要重新排 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.Didadida">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <!-- Google 登入走 Custom Tab，回來是 didadida://auth?n=<亂數>#token=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${authScheme}" android:host="auth" />
            </intent-filter>
        </activity>

        <!-- 桌面圖示的三張臉（MoodIcon.kt）。Android 沒有換圖示的 API，只能三個 alias 輪流啟用；
             LAUNCHER 因此不在 MainActivity 身上。⚠️ 必須排在 MainActivity 後面（targetActivity 要先宣告） -->
        <activity-alias
            android:name=".LauncherSmile"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_smile"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherAngry"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_angry"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherCry"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_cry"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".DuplicateActivity"
            android:launchMode="singleTop"
            android:exported="false"
            android:label="@string/dup_title" />

        <service
            android:name=".upload.UploadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- 推播（FCM）：上線／上傳通知，見 push/PushService.kt -->
        <service android:name=".push.PushService" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- 桌面小工具：輪播本次精選（FeaturedWidget.kt）。APPWIDGET_UPDATE 是系統送的，所以要 exported -->
        <receiver android:name=".FeaturedWidget" android:exported="true" android:label="@string/widget_featured_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_featured_info" />
        </receiver>

        <!-- 小工具的透明度設定（WidgetConfigActivity.kt）。系統的桌面要能叫它，所以要 exported -->
        <activity
            android:name=".WidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_featured_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- 自我更新：PackageInstaller 的安裝結果，只收自己發的 PendingIntent -->
        <receiver android:name=".InstallReceiver" android:exported="false" />

        <!-- 更新裝好之後系統送給新版的那一則，發「已更新」通知並清掉安裝檔 -->
        <receiver android:name=".UpdatedReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 桌面圖示換臉：每天 00:00 的鬧鐘與開機後重排（MoodIcon.kt） -->
        <receiver android:name=".MoodIcon$Receiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
